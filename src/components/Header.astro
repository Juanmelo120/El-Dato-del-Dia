---
import Social from './Social.astro';
import Icon from './Icon.astro';
import { SITE, CATEGORIES } from '../config';
const path = Astro.url.pathname;
---
<header class="header">
  <a class="promo-bar" href={SITE.youtube} target="_blank" rel="noopener">Nuevo video cada día en <strong>TikTok</strong> y <strong>YouTube</strong><span class="handle"> · {SITE.tiktokHandle}</span> →</a>
  <div class="container bar">
    <a href="/" class="logo" aria-label={`${SITE.name}, inicio`}>
      <img src="/perfil.png" alt="" width="36" height="36" class="avatar" />
      <span><span class="gold">El Dato</span> <span class="cyan">del Día</span></span>
    </a>
    <div class="right">
    <Social variant="icons" />
    <a href="/#buscar" class="btn btn--marker btn--sm"><Icon name="search" size={16} /><span class="lbl">Buscar dato</span></a>
    </div>
  </div>
  <nav class="container cats" aria-label="Categorías">
    {Object.entries(CATEGORIES).map(([slug, c]) => (
      <a href={`/categoria/${slug}`} aria-current={path.startsWith(`/categoria/${slug}`) ? 'page' : undefined}><Icon name={c.icon} size={15} />{c.name}</a>
    ))}
  </nav>
</header>
<style>
  .header { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: saturate(1.6) blur(14px); -webkit-backdrop-filter: saturate(1.6) blur(14px); border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 20px; height: 64px; }
  .logo { display: flex; align-items: center; gap: 10px; font: 800 19px/1 var(--font-display); letter-spacing: -0.03em; text-decoration: none; white-space: nowrap; }
  .avatar { width: 36px; height: 36px; object-fit: cover; border-radius: 50%; box-shadow: 0 0 0 2px var(--bg), 0 0 0 3px var(--magenta); }
  .cats { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding-bottom: 10px; font-size: 14px; }
  .cats::-webkit-scrollbar { display: none; }
  .cats a { flex: none; display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; border-radius: 999px; text-decoration: none; color: var(--muted); transition: color 150ms ease, background-color 150ms ease; }
  .cats a:hover { color: var(--ink); background: var(--surface); }
  .cats a[aria-current] { color: var(--marker-ink); background: var(--marker); }
  @media (min-width: 1100px) { .cats { flex-wrap: wrap; justify-content: space-between; gap: 0; } .cats a { padding: 7px 9px; } .cats a :global(.icon) { display: none; } }
  .promo-bar { display: block; text-align: center; padding: 7px 16px; font-size: 13px; text-decoration: none; color: #fff; background: linear-gradient(90deg, #fe2c55, #ff0033 50%, #7c3aed); }
  .promo-bar:hover { filter: brightness(1.08); }
  @media (max-width: 480px) { .handle { display: none; } }
  .right { display: flex; align-items: center; gap: 10px; }
  @media (max-width: 520px) { .lbl { display: none; } }
  .btn--sm { padding: 10px 16px; font-size: 14px; }
  @media (max-width: 400px) { .logo { font-size: 17px; } .btn--sm { padding: 10px 12px; } }
</style>
