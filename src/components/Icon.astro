---
// Íconos de Lucide (lucide.dev), incrustados como SVG en build.
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';
interface Props { name: string; size?: number; class?: string; }
const { name, size = 18, class: cls = '' } = Astro.props;
const require = createRequire(import.meta.url);
const raw = readFileSync(require.resolve(`lucide-static/icons/${name}.svg`), 'utf8');
const svg = raw
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace('<svg', `<svg aria-hidden="true" class="icon ${cls}"`);
---
<Fragment set:html={svg} />
