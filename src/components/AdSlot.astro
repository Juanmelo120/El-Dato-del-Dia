---
// Espacio de anuncio. Crea las unidades en AdSense y pon aquí su "slot" id.
import { SITE } from '../config';
interface Props { slot?: string; }
const { slot = '' } = Astro.props;
const active = SITE.adsenseClient && slot;
---
{active ? (
  <div class="ad">
    <ins class="adsbygoogle" style="display:block;width:100%" data-ad-client={SITE.adsenseClient} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
) : import.meta.env.DEV ? (
  <div class="ad ad--placeholder">Espacio publicitario</div>
) : null}
