---
// Botones para seguir en TikTok y YouTube. variant: 'full' (botones grandes) o 'icons' (solo iconos).
import { SITE } from '../config';
interface Props { variant?: 'full' | 'icons'; }
const { variant = 'full' } = Astro.props;
const tiktok = 'M16.6 5.8A4.3 4.3 0 0 1 15.5 3h-3.1v12.4a2.6 2.6 0 1 1-2.6-2.6c.3 0 .5 0 .8.1V9.7a5.7 5.7 0 1 0 4.9 5.7V9a7.3 7.3 0 0 0 4.3 1.4V7.3a4.3 4.3 0 0 1-3.2-1.5Z';
const youtube = 'M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8ZM10 15V9l5.2 3L10 15Z';
const redes = [
  { id: 'tiktok', url: SITE.tiktok, path: tiktok, label: 'Síguenos en TikTok', corto: 'TikTok' },
  { id: 'youtube', url: SITE.youtube, path: youtube, label: 'Suscríbete en YouTube', corto: 'YouTube' },
];
---
<div class={`social social--${variant}`}>
  {redes.map((r) => (
    <a class={`sbtn sbtn--${r.id}`} href={r.url} target="_blank" rel="noopener" aria-label={r.label}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d={r.path} /></svg>
      {variant === 'full' && <span>{r.label}</span>}
    </a>
  ))}
</div>
<style>
  .social { display: flex; flex-wrap: wrap; gap: 10px; }
  .sbtn { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; font-weight: 700; color: #fff; border-radius: 999px; transition: transform 150ms ease, filter 150ms ease; }
  .sbtn:hover { transform: translateY(-1px); filter: brightness(1.1); }
  .sbtn:active { transform: scale(0.97); }
  .sbtn--tiktok { background: #010101; box-shadow: -2px -2px 0 #25f4ee, 2px 2px 0 #fe2c55; }
  .sbtn--youtube { background: #ff0033; }
  .social--full .sbtn { padding: 12px 20px; font-size: 15px; }
  .social--icons { gap: 8px; }
  .social--icons .sbtn { width: 36px; height: 36px; justify-content: center; }
  .social--icons .sbtn--tiktok { box-shadow: -1.5px -1.5px 0 #25f4ee, 1.5px 1.5px 0 #fe2c55; }
</style>
