---
// Fila editorial de un dato: número, categoría, título y gancho.
import Icon from './Icon.astro';
import { CATEGORIES } from '../config';
interface Props { dato: any; }
const { dato } = Astro.props;
const cat = CATEGORIES[dato.data.category];
---
<li class="row">
  <a href={`/datos/${dato.id}`}>
    <span class="num n">{String(dato.data.numero).padStart(3, '0')}</span>
    <span class="body">
      <span class="cat muted"><Icon name={cat.icon} size={14} />{cat.name}</span>
      <span class="t">{dato.data.title}</span>
      <span class="h muted">{dato.data.hook}</span>
    </span>
    <Icon name="arrow-up-right" size={22} class="go" />
  </a>
</li>
<style>
  .row { border-top: 1px solid var(--line); }
  a { display: grid; grid-template-columns: 72px 1fr auto; gap: 20px; align-items: start; padding: 26px 4px; text-decoration: none; }
  .n { font-size: 15px; color: var(--muted); padding-top: 6px; transition: color 150ms ease; }
  .body { display: grid; gap: 8px; }
  .cat { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 500; }
  .t { font: 800 clamp(22px, 3vw, 30px)/1.1 var(--font-display); letter-spacing: -0.03em; text-wrap: balance; }
  .h { font-size: 16px; max-width: 60ch; }
  a :global(.go) { margin-top: 6px; color: var(--muted); transition: transform 200ms var(--ease-out), color 150ms ease; }
  a:active .t { opacity: .7; }
  @media (hover: hover) and (pointer: fine) {
    a:hover .n, a:hover :global(.go) { color: var(--ink); }
    a:hover :global(.go) { transform: translate(2px, -2px); }
    a:hover .t { text-decoration: underline; text-decoration-color: var(--marker); text-decoration-thickness: 4px; text-underline-offset: 0.12em; }
  }
  @media (max-width: 560px) { a { grid-template-columns: 1fr auto; gap: 8px 16px; } .n { grid-column: 1 / -1; padding: 0; } }
</style>
