---
import { CATEGORIES } from '../config';
interface Props { dato: any; }
const { dato } = Astro.props;
const cat = CATEGORIES[dato.data.category];
---
<a href={`/datos/${dato.id}`} class="card">
  <span class="top"><span class="badge">{cat.emoji} {cat.name}</span><span class="num muted">#{dato.data.numero}</span></span>
  <h3>{dato.data.title}</h3>
  <p class="muted">{dato.data.hook}</p>
  <span class="more">Leer la historia completa →</span>
</a>
<style>
  .card { display: flex; flex-direction: column; gap: 10px; padding: 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; transition: transform 200ms var(--ease-out), box-shadow 200ms var(--ease-out), border-color 200ms var(--ease-out); }
  @media (hover: hover) { .card:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgb(0 0 0 / .07); border-color: color-mix(in srgb, var(--accent) 35%, var(--line)); } }
  .card:active { transform: scale(0.99); }
  .top { display: flex; justify-content: space-between; align-items: center; }
  h3 { font-size: 22px; margin: 4px 0 0; }
  p { margin: 0; font-size: 15px; }
  .more { margin-top: auto; padding-top: 8px; font-weight: 600; font-size: 14px; color: var(--accent); }
</style>
