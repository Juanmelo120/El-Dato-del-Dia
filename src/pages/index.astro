---
import Base from '../layouts/Base.astro';
import DatoList from '../components/DatoList.astro';
import AdSlot from '../components/AdSlot.astro';
import Icon from '../components/Icon.astro';
import { getDatos } from '../lib';
import { SITE, CATEGORIES } from '../config';
const datos = await getDatos();
const [hoy, ...resto] = datos;
const fecha = hoy?.data.date.toLocaleDateString('es', { weekday: 'long', day: 'numeric', month: 'long' });
---
<Base jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: Astro.site?.href }]}>
  {hoy && (
    <section class="container hero">
      <p class="stamp"><span class="num">Dato #{hoy.data.numero}</span><span class="muted">Hoy, {fecha}</span></p>
      <h1><a href={`/datos/${hoy.id}`}><span class="mark mark--draw">{hoy.data.hook}</span></a></h1>
      <p class="lead">{hoy.data.description}</p>
      <a class="btn" href={`/datos/${hoy.id}`}>Leer la historia <Icon name="arrow-right" size={17} /></a>
    </section>
  )}

  <nav class="container cats" aria-label="Explorar por categoría">
    {Object.entries(CATEGORIES).map(([slug, c]) => <a class="tag" href={`/categoria/${slug}`}><Icon name={c.icon} size={15} />{c.name}</a>)}
  </nav>

  <AdSlot slot="" />

  {resto.length > 0 && (
    <section class="container">
      <h2>Datos anteriores</h2>
      <DatoList datos={resto} />
    </section>
  )}
</Base>
<style>
  .hero { padding: clamp(48px, 9vw, 112px) 16px 48px; }
  .stamp { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; margin: 0 0 20px; font-size: 14px; }
  .stamp .num { background: var(--chip); color: var(--marker); padding: 6px 10px; border-radius: 6px; font-size: 13px; }
  .stamp .muted::first-letter { text-transform: uppercase; }
  h1 { font-size: clamp(40px, 7.4vw, 92px); line-height: 1.08; max-width: 16ch; margin: 0 0 28px; }
  h1 a { text-decoration: none; }
  .lead { font-size: clamp(18px, 2vw, 20px); color: var(--ink-2); max-width: 56ch; margin: 0 0 32px; }
  .cats { display: flex; flex-wrap: wrap; gap: 8px; }
  h2 { font-size: clamp(26px, 3.4vw, 34px); margin: 72px 0 24px; }
</style>
