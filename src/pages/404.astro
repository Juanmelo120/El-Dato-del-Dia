---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada">
  <section class="container" style="padding:96px 16px;text-align:center">
    <p class="eyebrow">Dato curioso: error 404</p>
    <h1 style="font-size:48px">Esta página no existe… todavía.</h1>
    <p class="muted">El código 404 viene del protocolo HTTP de 1992: el 4 indica que el error es del lado del cliente.</p>
    <a class="btn" href="/tiktok">Buscar un dato</a>
  </section>
</Base>
