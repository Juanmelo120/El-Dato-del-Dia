---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Página no encontrada">
  <section class="container nf">
    <h1>Esta página <span class="mark">no existe</span>.</h1>
    <p class="muted">Dato de consuelo: el error 404 significa que el problema está del lado de quien pide la página, no del servidor. Vuelve a buscar el dato que viste.</p>
    <a class="btn" href="/tiktok"><Icon name="search" size={16} />Buscar un dato</a>
  </section>
</Base>
<style>
  .nf { padding: clamp(64px, 12vw, 140px) 16px; max-width: 720px; }
  h1 { font-size: clamp(40px, 7vw, 72px); margin: 0 0 20px; }
  p { font-size: 18px; margin: 0 0 32px; }
</style>
